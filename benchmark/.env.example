# AgentReliabilityBench — API Keys
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# Required: At least ONE of these to run the benchmark
OPENAI_API_KEY=sk-your-openai-key-here        # For GPT-4o, GPT-4o-mini, AND for the judge
ANTHROPIC_API_KEY=sk-ant-your-key-here         # For Claude 3.5 Sonnet
GOOGLE_API_KEY=your-google-ai-key-here         # For Gemini 1.5 Flash
TOGETHER_API_KEY=your-together-key-here        # For Llama 3.1 (8B, 70B) and Qwen 2.5 72B

# Note: The judge (GPT-4o-mini) uses OPENAI_API_KEY by default.
# So even if you only test Claude or Gemini, you still need OPENAI_API_KEY for judging.
